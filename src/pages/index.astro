---
import Base from '../layouts/Base.astro';
import Rail from '../components/Rail.astro';
import RailSection from '../components/RailSection.astro';
import Hero from '../components/Hero.astro';
import Projects from '../components/Projects.astro';
import Vision from '../components/Vision.astro';
import BuildLog from '../components/BuildLog.astro';
import People from '../components/People.astro';
import Contact from '../components/Contact.astro';
import { railNames as r } from '../data/site.ru';
---
<Base>
  <Rail>
    <RailSection id="top" n="01" name={r.start}><Hero /></RailSection>
    <RailSection id="projects" n="02" name={r.projects} title="Мои проекты"><Projects /></RailSection>
    <RailSection id="vision" n="03" name={r.vision}><Vision /></RailSection>
    <RailSection id="log" n="04" name={r.log} title="Журнал стройки"><BuildLog /></RailSection>
    <RailSection id="people" n="05" name={r.people} title="Ищу людей"><People /></RailSection>
    <RailSection id="contact" n="06" name={r.contact}><Contact /></RailSection>
  </Rail>
</Base>
