---
import Base from '../../layouts/Base.astro';
import { site, watch as w } from '../../data/site.ru';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const tg = site.links.telegram || `${base}/#contact`;
---
<Base title={w.title} description={w.description} noindex>
  <section class="section">
    <div class="wrap watch">
      <p class="label label--or">{w.label}</p>
      <h1>{w.h1}</h1>
      <span class="hair"></span>
      <p class="lead">{w.lead}</p>

      <div class="player frame" id="player" data-embed={w.embedBase} data-page={w.pageBase}>
        <div class="player__box" id="box">
          <div class="player__empty" id="empty">
            <p class="label">{w.emptyTitle}</p>
            <p>{w.emptyText}</p>
          </div>
        </div>
      </div>
      <p class="open" id="open" hidden><a class="btn btn--ghost" id="openLink" href="#" rel="noopener">{w.openLabel}</a></p>

      <div class="next tile tile--soft">
        <p class="label label--or">{w.nextLabel}</p>
        <h2>{w.nextTitle}</h2>
        <p>{w.nextText}</p>
        <div class="next__btns">
          <a class="btn" href={`${base}/`}>{w.ctaSite} →</a>
          <a class="btn btn--ghost" href={tg}>{w.ctaTelegram}</a>
        </div>
      </div>
    </div>
  </section>
  <script>
    // Код видео берём только из безопасных символов, чтобы в адрес нельзя было подставить чужой.
    const el = document.getElementById('player');
    const id = new URLSearchParams(location.search).get('id') || '';
    if (el && /^[A-Za-z0-9_-]{4,64}$/.test(id)) {
      const iframe = document.createElement('iframe');
      iframe.src = (el.dataset.embed || '') + id;
      iframe.title = 'Видео';
      iframe.allow = 'fullscreen; picture-in-picture; autoplay';
      iframe.allowFullscreen = true;
      iframe.loading = 'lazy';
      const box = document.getElementById('box');
      document.getElementById('empty')?.remove();
      box?.appendChild(iframe);
      const link = document.getElementById('openLink') as HTMLAnchorElement | null;
      if (link) link.href = (el.dataset.page || '') + id;
      document.getElementById('open')?.removeAttribute('hidden');
    }
  </script>
</Base>
<style>
  .watch { max-width: 960px; }
  .player { margin-top: 28px; }
  .player__box { position: relative; aspect-ratio: 16 / 9; background: var(--srf-2); border: 1px solid var(--border-soft); overflow: hidden; }
  .player__box :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .player__empty { position: absolute; inset: 0; display: grid; place-content: center; text-align: center; padding: 24px; gap: 6px; }
  .player__empty p { margin: 0; color: var(--ink-2); max-width: 44ch; }
  .open { margin: 12px 0 0; }
  .next { margin-top: clamp(32px, 6vw, 56px); padding: 28px 26px; }
  .next h2 { font-size: clamp(20px, 3vw, 30px); margin: 0 0 10px; }
  .next p { color: var(--rw-gray-700); }
  .next__btns { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; margin-top: 18px; }
</style>
