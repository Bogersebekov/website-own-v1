---
// Фирма — v1.0: 9 блоков из docs/site-content-2026-10-16/firm-copy.md.
import Base from '../layouts/Base.astro';
import Rail from '../components/Rail.astro';
import RailSection from '../components/RailSection.astro';
import PageHero from '../components/PageHero.astro';
import Cta from '../components/Cta.astro';
import CtaBlock from '../components/CtaBlock.astro';
import { firmPage as f } from '../data/site.ru';
---
<Base title={f.title} description={f.description}>
  <Rail>
    <RailSection id="top" n="01" name="Старт">
      <PageHero label={f.hero.label} title={f.hero.title} lead={f.hero.lead}>
        <Cta label={f.hero.cta.label} href={f.hero.cta.href} />
      </PageHero>
    </RailSection>

    <RailSection id="who" n="02" name={f.who.kicker} title={f.who.title}>
      <div class="tile s6">
        <ul class="ticks">{f.who.items.map((t) => <li>{t}</li>)}</ul>
      </div>
      <div class="tile s6">
        <h3>{f.who.whyTitle}</h3>
        <ul class="ticks">{f.who.why.map((t) => <li>{t}</li>)}</ul>
      </div>
      <div class="tile tile--soft">
        <p><b class="em">{f.who.directionTitle}</b> {f.who.direction[0]}</p>
        {f.who.direction.slice(1).map((p) => <p>{p}</p>)}
      </div>
    </RailSection>

    <RailSection id="unite" n="03" name={f.unite.kicker} title={f.unite.title}>
      {f.unite.items.map((t, i) => (
        <div class="tile s4 plate"><span class="code">{String(i + 1).padStart(2, '0')}</span><h3>{t}</h3></div>
      ))}
    </RailSection>

    <RailSection id="now" n="04" name={f.now.kicker}>
      <div class="tile s8">
        <h3>{f.now.title}</h3>
        <p>{f.now.text}</p>
      </div>
    </RailSection>

    <RailSection id="mastery" n="05" name={f.mastery.kicker} title={f.mastery.title}>
      <div class="tile s8">
        <ul class="ticks">{f.mastery.items.map((t) => <li>{t}</li>)}</ul>
      </div>
      <div class="tile s4 tile--soft">
        <h3>{f.mastery.notTitle}</h3>
        <ul class="ticks ticks--no">{f.mastery.not.map((t) => <li>{t}</li>)}</ul>
      </div>
    </RailSection>

    <RailSection id="first" n="06" name={f.first.kicker} title={f.first.title}>
      {f.first.items.map((t, i) => (
        <div class="tile s4 plate"><span class="code">{String(i + 1).padStart(2, '0')}</span><h3>{t}</h3></div>
      ))}
    </RailSection>

    <RailSection id="goal" n="07" name={f.goal.kicker} title={f.goal.title}>
      <div class="tile">
        <ul class="ticks">{f.goal.items.map((t) => <li>{t}</li>)}</ul>
      </div>
    </RailSection>

    <RailSection id="start" n="08" name={f.start.kicker} title={f.start.title}>
      <div class="tile">
        <ol class="steps">{f.start.items.map((t) => <li>{t}</li>)}</ol>
      </div>
    </RailSection>

    <RailSection id="contact" n="09" name={f.contact.kicker}>
      <CtaBlock title={f.contact.title} text={f.contact.text} cta={f.contact.cta} />
    </RailSection>
  </Rail>
</Base>
