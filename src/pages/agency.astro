---
// Агентство — A-PAGE-001 v1.0: 6 блоков из docs/site-content-2026-10-16/agency-copy.md + слоты портфолио.
import Base from '../layouts/Base.astro';
import Rail from '../components/Rail.astro';
import RailSection from '../components/RailSection.astro';
import PageHero from '../components/PageHero.astro';
import Cta from '../components/Cta.astro';
import CaseCard from '../components/CaseCard.astro';
import CtaBlock from '../components/CtaBlock.astro';
import Portfolio from '../components/Portfolio.astro';
import { agencyPage as a } from '../data/site.ru';
---
<Base title={a.title} description={a.description}>
  <Rail>
    <RailSection id="top" n="01" name="Старт">
      <PageHero label={a.hero.label} title={a.hero.title} lead={a.hero.lead}>
        <Cta label={a.hero.cta.label} href={a.hero.cta.href} />
      </PageHero>
    </RailSection>

    <RailSection id="case" n="02" name={a.caseKicker}><CaseCard /></RailSection>

    <RailSection id="tasks" n="03" name={a.tasks.kicker} title={a.tasks.title}>
      {a.tasks.items.map((t) => (
        <div class="tile s6"><h3>{t.title}</h3><p>{t.text}</p></div>
      ))}
    </RailSection>

    <RailSection id="services" n="04" name={a.services.kicker} title={a.services.title}>
      {a.services.items.map((s, i) => (
        <div class="tile s6 svc">
          <span class="code">{String(i + 1).padStart(2, '0')}</span>
          <h3>{s.title}</h3>
          {s.paragraphs.map((p) => <p>{p}</p>)}
          <p class="svc__label">{a.services.includesLabel}</p>
          <ul class="ticks">{s.includes.map((t) => <li>{t}</li>)}</ul>
        </div>
      ))}
      <p class="span-all muted">{a.services.foot}</p>
    </RailSection>

    <RailSection id="work" n="05" name="Примеры" title="Примеры работ"><Portfolio /></RailSection>

    <RailSection id="faq" n="06" name={a.faq.kicker} title={a.faq.title}>
      <div class="tile faq">
        {a.faq.items.map((q) => (
          <details>
            <summary>{q.q}</summary>
            <p>{q.a}</p>
          </details>
        ))}
      </div>
    </RailSection>

    <RailSection id="contact" n="07" name={a.contact.kicker}>
      <CtaBlock title={a.contact.title} text={a.contact.text} cta={a.contact.cta} />
    </RailSection>
  </Rail>
</Base>
