---
import "../styles/studio.css";
import "../styles/portrait-lab.css";
import PortraitControls from "../components/PortraitControls.astro";
import { portraitLab as lab } from "../data/site.ru";
import { site, homePoster as h, studioDesign as d } from "../data/site.ru";
import Arrow from "../components/StudioArrow.astro";
import Wordmark from "../components/StudioWordmark.astro";
import { siteEditions } from "../data/site.ru";
import "../styles/site-editions.css";
import "../styles/typography-refinements.css";
import { typographyRefinements } from "../data/site.ru";
interface Props {
  variant?: "portrait" | "studio" | "editorial";
  look?: string;
  board?: boolean;
  edition?: string;
  refinement?: string;
  article?: boolean;
  pageSlug?: string;
  title?: string;
}
const {
  variant = "portrait",
  look,
  board = false,
  edition,
  refinement,
  article = false,
  pageSlug = "",
  title,
} = Astro.props;
const activeEdition = siteEditions.find((item) => item.id === edition);
const preset = activeEdition
  ? {
      ...lab.looks.find((item) => item.id === "haze")!,
      buttons: "outline",
      cards: activeEdition.id,
      portrait: "natural",
      grid: false,
    }
  : lab.looks.find((item) => item.id === look);
const labActive = Boolean(preset);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const homeHref = refinement
  ? `${base}/refine/${refinement}/`
  : activeEdition
    ? `${base}/preview/${activeEdition.id}/`
    : `${base}/`;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ?? `${site.title} — ${activeEdition?.name ?? d.variants.find(v=>v.id===variant)?.name}`}</title>
    <meta name="description" content={h.intro} />
    <meta name="theme-color" content="#141414" />
    {(Astro.url.pathname.includes("/variants/") ||
      Astro.url.pathname.includes("/looks/") ||
      Astro.url.pathname.includes("/preview/") ||
      Astro.url.pathname.includes("/refine/")) && (
      <meta name="robots" content="noindex, nofollow" />
    )}
    <meta property="og:title" content={site.title} />
    <meta property="og:description" content={h.intro} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="canonical" href={new URL(`${base}/`, Astro.site)} />
  </head>
  <body
    class:list={[
      `design-${variant}`,
      {
        "look-active": labActive,
        "site-edition": Boolean(activeEdition),
        "detail-page": article,
      },
    ]}
    data-refinement={refinement}
    data-edition={activeEdition?.id}
    data-look={activeEdition ? "haze" : look}
    data-buttons={preset?.buttons}
    data-portrait={preset?.portrait}
    data-cards={preset?.cards}
    data-grid={String(preset?.grid ?? false)}
  >
    <a class="studio-skip" href="#main">
      {d.ui.skip}
    </a>
    {refinement ? (
      <div
        class="edition-switch"
        role="navigation"
        aria-label="Варианты доработки"
      >
        <span>JETIX / Типографика · дымка · контур</span>
        <div>
          {typographyRefinements.map((item) => (
            <a
              href={`${base}/refine/${item.id}/${pageSlug ? pageSlug + "/" : ""}`}
              aria-current={refinement === item.id ? "page" : undefined}
            >
              {item.name}
            </a>
          ))}
        </div>
      </div>
    ) : activeEdition ? (
      <div
        class="edition-switch"
        role="navigation"
        aria-label="Оформление сайта"
      >
        <span>JETIX / Оранжевая дымка + контур</span>
        <div>
          {siteEditions.map((item) => (
            <a
              href={`${base}/preview/${item.id}/${pageSlug ? pageSlug + "/" : ""}`}
              aria-current={activeEdition.id === item.id ? "page" : undefined}
            >
              <b>{item.number}</b>
              {item.name}
            </a>
          ))}
        </div>
      </div>
    ) : board ? (
      <div class="board-toplink">
        <a href={`${base}/looks/ember/`}>← К фонам и портрету</a>
      </div>
    ) : preset ? (
      <PortraitControls
        look={look}
        buttonStyle={preset.buttons}
        portraitStyle={preset.portrait}
        cardStyle={preset.cards}
        grid={preset.grid}
      />
    ) : (
      <div class="design-switch" role="navigation" aria-label={d.ui.variants}>
        <span class="switch-label">JETIX / {d.ui.variants}</span>
        <div>
          {d.variants.map((v) => (
            <a
              href={`${base}/variants/${v.id}/`}
              aria-current={variant === v.id ? "page" : undefined}
            >
              <span>{v.number}</span>
              {v.name}
            </a>
          ))}
        </div>
      </div>
    )}
    <div class="studio-shell">
      <header class="studio-header">
        <a class="studio-logo" href={homeHref} aria-label="Jetix — на главную">
          <Wordmark />
        </a>
        <nav aria-label="Основная навигация">
          {d.navigation.map((n) => (
            <a href={article || board ? `${homeHref}#${n.id}` : `#${n.id}`}>
              {n.label}
            </a>
          ))}
        </nav>
        <a class="header-cta" href={site.links.telegram}>
          {h.ui.contact}
          <Arrow />
        </a>
      </header>
      <main id="main">
        <slot />
      </main>
      <footer class="studio-footer">
        <a class="studio-logo" href={homeHref}>
          <Wordmark />
        </a>
        <span>{h.name}</span>
        <nav aria-label={d.ui.social}>
          <span>YouTube</span>
          <span>Instagram</span>
          <a href={site.links.telegram}>
            Telegram
            <Arrow />
          </a>
        </nav>
      </footer>
    </div>
    <dialog class="image-viewer" aria-label="Скриншоты проекта">
      <div class="viewer-top">
        <span class="viewer-caption"></span>
        <button type="button" data-viewer-close aria-label={d.ui.close}>
          ×
        </button>
      </div>
      <button
        class="viewer-prev"
        type="button"
        data-viewer-prev
        aria-label={d.ui.previous}
      >
        ←
      </button>
      <div class="viewer-stage">
        <img class="viewer-image" alt="" />
      </div>
      <button
        class="viewer-next"
        type="button"
        data-viewer-next
        aria-label={d.ui.next}
      >
        →
      </button>
    </dialog>
    <script>
      const viewer = document.querySelector<HTMLDialogElement>(".image-viewer");
      const controls = Array.from(
        document.querySelectorAll<HTMLButtonElement>("[data-image-full]"),
      );
      let selected = 0;
      let opener: HTMLElement | null = null;
      const show = (index: number) => {
        if (!viewer || !controls.length) return;
        selected = (index + controls.length) % controls.length;
        const source = controls[selected];
        const img = viewer.querySelector<HTMLImageElement>(".viewer-image");
        const caption = viewer.querySelector(".viewer-caption");
        if (img) {
          img.src = source.dataset.imageFull || "";
          img.alt = source.dataset.imageAlt || "";
        }
        if (caption)
          caption.textContent = `${selected + 1} / ${controls.length} — ${source.dataset.imageTitle}`;
      };
      controls.forEach((button, index) =>
        button.addEventListener("click", () => {
          opener = button;
          show(index);
          viewer?.showModal();
          document.body.classList.add("viewer-open");
        }),
      );
      viewer
        ?.querySelector("[data-viewer-close]")
        ?.addEventListener("click", () => viewer.close());
      viewer
        ?.querySelector("[data-viewer-prev]")
        ?.addEventListener("click", () => show(selected - 1));
      viewer
        ?.querySelector("[data-viewer-next]")
        ?.addEventListener("click", () => show(selected + 1));
      viewer?.addEventListener("click", (e) => {
        if (e.target === viewer) viewer.close();
      });
      viewer?.addEventListener("close", () => {
        document.body.classList.remove("viewer-open");
        opener?.focus();
      });
      viewer?.addEventListener("keydown", (e) => {
        if (e.key === "ArrowRight") {
          show(selected + 1);
          e.preventDefault();
        }
        if (e.key === "ArrowLeft") {
          show(selected - 1);
          e.preventDefault();
        }
      });
    </script>
  </body>
</html>
