---
import '../styles/jx-v2.css';
import '../styles/or-acc.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site.ru';

interface Props { title?: string; description?: string; noindex?: boolean; image?: string }
const { title = site.title, description = site.description, noindex = false, image } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site);
// Аналитика без cookie: Cloudflare Web Analytics. Токен — переменная сборки PUBLIC_CF_WEB_ANALYTICS_TOKEN
// (GitHub → Settings → Secrets and variables → Actions → Variables). Пусто = скрипт не подключается.
// Инструкция: docs/analitika.md
const cfToken = import.meta.env.PUBLIC_CF_WEB_ANALYTICS_TOKEN || '';
---
<!doctype html>
<html lang={site.lang} data-or="b">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
    {image && <meta name="twitter:card" content="summary_large_image" />}
    <meta property="og:locale" content="ru_RU" />
    <meta name="theme-color" content="#13111C" />
    {cfToken && <script defer is:inline src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: cfToken })}></script>}
  </head>
  <body>
    <div class="bg" aria-hidden="true"><div class="bg__grid"></div></div>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <script>
      // Появление блоков при прокрутке. Короткие переходы, без петель.
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
      }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
