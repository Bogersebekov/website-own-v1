---
import { contact, site } from '../data/site.ru';
const tg = site.links.telegram || '#contact';
---
<div class="tile tile--hl" id="contact">
  <p class="label label--or">{contact.label}</p>
  <h2>{contact.title}</h2>
  <p class="lead" style="margin-block:10px 8px">{contact.text}</p>
  <span class="handle">{site.telegramHandle}</span>
  <a class="btn" href={tg}>{contact.cta} →</a>
</div>
<style>#contact { scroll-margin-top: 80px; }</style>
