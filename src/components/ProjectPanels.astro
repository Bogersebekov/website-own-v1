---
import { homePoster as h } from "../data/site.ru";
import Arrow from "./StudioArrow.astro";
interface Props {
  look?: string;
}
const { look } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<div class="s-project-grid">
  {h.projects.map((project, i) => (
    <article class={`s-project project-${i}`}>
      <div class="project-art" aria-hidden="true">
        {look && (
          <>
            <span class="project-type-mark">0{i + 1}</span>
            <svg
              class="project-diagram"
              viewBox="0 0 300 160"
              fill="none"
              aria-hidden="true"
            >
              {i === 0 ? (
                <>
                  <path d="M40 80 100 35 200 35 260 80 200 125 100 125Z M100 35 150 80 200 35M40 80h220M100 125 150 80 200 125" />
                  <circle cx="40" cy="80" r="7" />
                  <circle cx="100" cy="35" r="7" />
                  <circle cx="200" cy="35" r="7" />
                  <circle cx="260" cy="80" r="7" />
                  <circle cx="200" cy="125" r="7" />
                  <circle cx="100" cy="125" r="7" />
                  <circle cx="150" cy="80" r="11" />
                </>
              ) : i === 1 ? (
                <>
                  <path d="M50 125V35h145v90H50ZM80 20h145v90M110 5h145v90M70 60h100M70 80h70M175 100l45-45M185 55h35v35" />
                </>
              ) : (
                <>
                  <path d="M60 30h180v105H60zM60 60h180M85 45h2M100 45h2M115 45h2M80 80h35v35H80zM130 80h85M130 95h85M130 110h55" />
                </>
              )}
            </svg>
          </>
        )}

        {i === 0 ? (
          <div class="network-symbol">
            <i></i>
            <i></i>
            <i></i>
            <i></i>
            <i></i>
            <i></i>
          </div>
        ) : i === 1 ? (
          <div class="agency-symbol">
            <Arrow />
          </div>
        ) : (
          <div class="life-symbol">
            <i></i>
            <i></i>
            <i></i>
          </div>
        )}
      </div>
      <div class="s-project-content">
        <span class="s-project-number">0{i + 1}</span>
        <h3>{project.title}</h3>
        {project.status && <span class="s-status">{project.status}</span>}
        <p>{project.text}</p>
        <a class="studio-link" href={`${base}${project.href}`}>
          {project.cta}
          <Arrow />
        </a>
      </div>
    </article>
  ))}
</div>
