---
import Studio from "../layouts/Studio.astro";
import FirmPage from "./pages/FirmPage.astro";
import AgencyPage from "./pages/AgencyPage.astro";
import InterviewsPage from "./pages/InterviewsPage.astro";
import LifeOSPage from "./pages/LifeOSPage.astro";
import { siteDocumentTitles } from "../data/site.ru";
import { Content as Firm } from "../content/site-pages/firm.md";
import { Content as Agency } from "../content/site-pages/agency.md";
import { Content as Interviews } from "../content/site-pages/interviews.md";
import { Content as LifeOS } from "../content/site-pages/life-os.md";
interface Props {
  page: keyof typeof siteDocumentTitles;
  edition?: string;
  refinement?: string;
}
const { page, edition = "glass", refinement } = Astro.props;
const Pages = {
  firm: Firm,
  agency: Agency,
  interviews: Interviews,
  "life-os": LifeOS,
};
const DesignedPages = {
  firm: FirmPage,
  agency: AgencyPage,
  interviews: InterviewsPage,
  "life-os": LifeOSPage,
};
const Content = refinement ? DesignedPages[page] : Pages[page];
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const isComparison = /\/(refine|preview)\//.test(Astro.url.pathname);
const prefix =
  refinement && isComparison
    ? `${base}/refine/${refinement}`
    : !isComparison
      ? base
      : `${base}/preview/${edition}`;
---

<Studio
  variant="portrait"
  look="haze"
  edition={edition}
  refinement={refinement}
  article
  pageSlug={page}
  title={`${siteDocumentTitles[page]} · Jetix`}
>
  <article
    class:list={[
      "studio-document",
      { "composed-document": Boolean(refinement) },
    ]}
  >
    <a class="document-back" href={`${prefix}/`}>
      На главную
    </a>
    <nav class="document-navigation" aria-label="Разделы сайта">
      {Object.entries(siteDocumentTitles).map(([slug, label]) => (
        <a
          href={`${prefix}/${slug}/`}
          aria-current={slug === page ? "page" : undefined}
        >
          {label}
        </a>
      ))}
    </nav>
    <div class="document-copy">
      <Content />
    </div>
  </article>
</Studio>
