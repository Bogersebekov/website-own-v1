---
import { doors } from '../data/site.ru';
---
<section class="section" id="doors">
  <div class="wrap">
    <p class="label reveal">{doors.label}</p>
    <h2 class="reveal" style="--d:60ms">{doors.title}</h2>
    <span class="hair reveal" style="--d:100ms"></span>
    <div class="grid grid--2">
      {doors.items.map((d, i) => (
        <article class="card door reveal" style={`--d:${120 + i * 80}ms`}>
          <span class="card__top"></span>
          <span class="code">{d.code}</span>
          <h3>{d.title}</h3>
          <p>{d.intro}</p>
          <ul class="door__list">{d.get.map((g) => <li>{g}</li>)}</ul>
          <p>{d.start}</p>
          <a class="btn" href={d.cta.href}>{d.cta.label}</a>
        </article>
      ))}
    </div>
    <div class="not reveal" style="--d:120ms">
      <span class="label">{doors.not.title}</span>
      <ul class="not__list">{doors.not.items.map((n) => <li>{n}</li>)}</ul>
    </div>
  </div>
</section>
<style>
  .door { display: flex; flex-direction: column; gap: 14px; }
  .door h3 { font-size: clamp(19px, 2.4vw, 24px); margin: 4px 0 0; }
  .door .btn { align-self: flex-start; margin-top: auto; }
  .door__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .door__list li { padding-left: 22px; position: relative; color: var(--ink); font-weight: 400; font-size: 15px; }
  .door__list li::before { content: '—'; position: absolute; left: 0; color: var(--or-txt); }
  .not { margin-top: 36px; }
  .not__list { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px 28px; color: var(--ink-2); font-size: 15px; }
  .not__list li::before { content: '✕ '; color: var(--ink-orn); }
</style>
