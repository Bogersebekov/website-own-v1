---
import { facts } from '../data/site.ru';
---
<section class="facts" aria-label="Цифры">
  <div class="wrap">
    <ul class="facts__list reveal">
      {facts.map((f) => (
        <li><strong>{f.value}</strong><span>{f.label}</span></li>
      ))}
    </ul>
  </div>
</section>
<style>
  .facts { padding: 8px 0 20px; }
  .facts__list { list-style: none; margin: 0; padding: 18px 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px 24px;
    border-top: 1px solid var(--border-faint); border-bottom: 1px solid var(--border-faint); }
  .facts__list li { display: flex; flex-direction: column; gap: 2px; }
  .facts__list strong { font-family: var(--font-head); font-weight: 400; font-size: clamp(26px, 4vw, 40px); color: var(--ink-max); line-height: 1; }
  .facts__list span { font-size: 13px; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-3); font-weight: 400; }
  @media (min-width: 768px) { .facts__list { grid-template-columns: repeat(4, 1fr); } }
</style>
