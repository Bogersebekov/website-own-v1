---
import { site, nav } from '../data/site.ru';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const here = Astro.url.pathname.replace(base, '') || '/';
---
<header class="hdr">
  <div class="wrap hdr__in">
    <a class="hdr__brand" href={`${base}/`} aria-label="Jetix, на главную">
      <span class="hdr__mark" aria-hidden="true"></span>{site.brand}
    </a>
    <nav class="hdr__nav" aria-label="Разделы">
      {nav.map((n) => <a href={`${base}${n.href}`} aria-current={here.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>)}
    </nav>
    {site.links.telegram && <a class="btn hdr__cta" href={site.links.telegram} target="_blank" rel="noopener">Написать</a>}
  </div>
</header>
<style>
  .hdr { position: sticky; top: 0; z-index: 10; background: rgba(19,17,28,.82); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-bottom: 1px solid var(--border-faint); }
  .hdr__in { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0 16px; min-height: 64px; }
  .hdr__brand { display: inline-flex; align-items: center; gap: 10px; height: 64px; font-family: var(--font-head); font-size: 20px; letter-spacing: .12em; color: var(--ink-max); }
  .hdr__mark { width: 10px; height: 10px; background: var(--or-mark); clip-path: polygon(30% 0, 100% 0, 100% 70%, 70% 100%, 0 100%, 0 30%); }
  .hdr__nav { order: 3; flex-basis: 100%; display: flex; gap: 22px; overflow-x: auto; padding: 0 0 12px; scrollbar-width: none;
    font-weight: 400; font-size: 12px; letter-spacing: .14em; text-transform: uppercase; white-space: nowrap; }
  .hdr__nav::-webkit-scrollbar { display: none; }
  .hdr__nav a { color: var(--ink-2); transition: color var(--t-fast) var(--ease); padding-block: 4px; }
  .hdr__nav a:hover, .hdr__nav a[aria-current='page'] { color: var(--ink-max); }
  .hdr__nav a[aria-current='page'] { box-shadow: inset 0 -2px 0 var(--or-hair); }
  .hdr__cta { min-height: 40px; padding: 10px 16px; font-size: 12px; }
  @media (min-width: 900px) {
    .hdr__in { flex-wrap: nowrap; }
    .hdr__nav { order: 0; flex-basis: auto; padding: 0; gap: 28px; font-size: 13px; overflow: visible; }
  }
</style>
