---
import { hero, nowStatus, site } from '../data/site.ru';
const tg = site.links.telegram || hero.primary.href;
---
<div class="tile tile--hl s8" id="top">
  <p class="label label--or">{hero.label}</p>
  <h1>{hero.title}</h1>
  <p class="lead">{hero.lead}</p>
  <a class="btn" href={tg}>{hero.primary.label} →</a>
</div>
<div class="tile tile--col s4">
  <span class="status">{nowStatus.label}</span>
  <h3>{nowStatus.text}</h3>
</div>
