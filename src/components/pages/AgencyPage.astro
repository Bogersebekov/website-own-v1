---
import { Image, getImage } from "astro:assets";
import source from "../../content/site-pages/agency.md?raw";
import social from "../../assets/materials/course-social.png";
import landing from "../../assets/materials/course-landing.png";
import product from "../../assets/materials/course-product.png";

// The approved document remains the content source; layout is intentionally bespoke.
const sections = [
  ...source.matchAll(
    /<section class="document-section">([\s\S]*?)<\/section>/g,
  ),
].map((match) => match[1].trim());
const blocks = (value: string) =>
  value
    .split(/\n\n+/)
    .map((part) => part.trim())
    .filter(Boolean);
const clean = (value: string) =>
  value.replace(/^#{1,3}\s+/, "").replace(/\*\*/g, "");
const groups = (value: string) =>
  value
    .split(/\n### /)
    .slice(1)
    .map((part) => {
      const [title, ...body] = blocks(part);
      return {
        title,
        paragraphs: body.filter(
          (item) => !item.startsWith("-") && !item.startsWith("**"),
        ),
        list:
          body
            .find((item) => item.startsWith("-"))
            ?.split("\n")
            .map((item) => item.replace(/^- /, "")) ?? [],
      };
    });
const hero = blocks(sections[0]);
const tasks = groups(sections[2]);
const services = groups(sections[3]);
// This sentence closes the service section rather than the final service description.
const agreement = "Конкретный состав работы согласовываем под ваш проект.";
services.at(-1)!.paragraphs = services
  .at(-1)!
  .paragraphs.filter((item) => item !== agreement);
const faq = groups(sections[4]);
const closing = blocks(sections[5]);
const caseItems = blocks(sections[1]);
const facts = caseItems
  .find((item) => item.startsWith("-"))!
  .split("\n")
  .map((item) => item.replace(/^- /, ""));
const caseImages = [social, landing, product];
const caseFull = await Promise.all(
  caseImages.map((src) => getImage({ src, width: src.width, format: "webp" })),
);
const caseTitles = [
  "Материалы соцсетей проекта",
  "Лендинг курса The Meltdown Plan",
  "Состав образовательного продукта The Meltdown Plan",
];
---

<div class="agency-page">
  <section class="agency-hero" aria-labelledby="agency-heading">
    <p class="agency-eyebrow">Jetix Agency</p>
    <h1 id="agency-heading">
      <span>Продвижение, сайты</span> и воронки продаж{" "}
      <em>для экспертов и предпринимателей</em>
    </h1>
    <p class="agency-lead">{hero[1]}</p>
    <a class="studio-button" href="https://t.me/ferheiser">
      Обсудить задачу
    </a>
    <div class="agency-disciplines" aria-label="Направления работы">
      <span>Контент</span>
      <span>Сайты</span>
      <span>Воронки</span>
      <span>Исследование</span>
    </div>
  </section>

  <section class="agency-case" aria-labelledby="agency-case-heading">
    <div class="agency-section-heading">
      <p class="agency-eyebrow">Прошлый проект</p>
      <h2 id="agency-case-heading">{clean(caseItems[1])}</h2>
    </div>
    <div class="agency-case-layout">
      <div class="agency-case-work">
        <p class="agency-period">
          {clean(caseItems[2])}
          <span>{clean(caseItems[3])}</span>
        </p>
        <h3>Что было сделано</h3>
        <ul>
          {facts.map((fact) => (
            <li>{fact}</li>
          ))}
        </ul>
      </div>
      <div class="agency-case-result">
        <div class="agency-amount">
          <span class="agency-currency">$</span>
          <strong>
            35 000<span class="agency-plus">+</span>
          </strong>
        </div>
        <p>Выручка, сгенерированная за 3 месяца.</p>
        <small>Из прошлого продюсерского опыта.</small>
      </div>
    </div>
    <div class="agency-case-images">
      {caseImages.map((image, index) => (
        <button
          type="button"
          class="case-shot"
          data-image-full={caseFull[index].src}
          data-image-alt={caseTitles[index]}
          data-image-title={caseTitles[index]}
          aria-label={`Открыть: ${caseTitles[index]}`}
        >
          <Image
            src={image}
            width={650}
            alt={caseTitles[index]}
            loading="lazy"
          />
        </button>
      ))}
    </div>
  </section>

  <section class="agency-tasks" aria-labelledby="agency-tasks-heading">
    <div class="agency-section-heading">
      <p class="agency-eyebrow">Ваши задачи</p>
      <h2 id="agency-tasks-heading">С какими задачами можно обратиться</h2>
    </div>
    <div class="agency-task-grid">
      {tasks.map((task, index) => (
        <article class="agency-task">
          <span class="agency-task-index">
            {String(index + 1).padStart(2, "0")}
          </span>
          <h3>{task.title}</h3>
          {task.paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </article>
      ))}
    </div>
  </section>

  <section class="agency-services" aria-labelledby="agency-services-heading">
    <div class="agency-section-heading">
      <p class="agency-eyebrow">От идеи до запуска</p>
      <h2 id="agency-services-heading">Что берём на себя</h2>
    </div>
    <div class="agency-service-stack">
      {services.map((service) => (
        <article class="agency-service">
          <div class="agency-service-description">
            <h3>{service.title}</h3>
            {service.paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
          <div class="agency-service-scope">
            <h4>В состав работы входят</h4>
            <ul>
              {service.list.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>
    <p class="agency-agreement">{agreement}</p>
  </section>

  <section class="agency-faq" aria-labelledby="agency-faq-heading">
    <div class="agency-section-heading">
      <p class="agency-eyebrow">Перед началом</p>
      <h2 id="agency-faq-heading">Частые вопросы</h2>
    </div>
    <div class="agency-faq-list">
      {faq.map((item, index) => (
        <details open={index === 0}>
          <summary>
            {item.title}
            <span class="agency-faq-toggle" aria-hidden="true"></span>
          </summary>
          {item.paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </details>
      ))}
    </div>
  </section>

  <section class="agency-contact" aria-labelledby="agency-contact-heading">
    <p class="agency-eyebrow">Начнём с разговора</p>
    <h2 id="agency-contact-heading">{clean(closing[1])}</h2>
    <p>{closing[2]}</p>
    <a class="studio-button" href="https://t.me/ferheiser">
      Обсудить задачу
    </a>
  </section>
</div>

<style>
  .agency-page {
    --agency-orange: #ff783d;
    color: #efedf0;
    min-width: 0;
  }
  .agency-page section {
    margin-bottom: clamp(58px, 8vw, 112px);
  }
  .agency-page h1,
  .agency-page h2,
  .agency-page h3,
  .agency-page h4,
  .agency-page p {
    margin: 0;
  }
  .agency-page h1,
  .agency-page h2,
  .agency-page h3 {
    font-family: Unbounded, sans-serif;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }
  .agency-page h2 {
    font-size: clamp(25px, 3.4vw, 42px);
    line-height: 1.3;
    max-width: 23ch;
  }
  .agency-page p,
  .agency-page li {
    font-size: clamp(14px, 1.2vw, 16px);
    line-height: 1.8;
    color: #b5b0b8;
  }
  .agency-page .agency-eyebrow {
    font:
      12px/1.4 Iosevka,
      monospace;
    text-transform: uppercase;
    letter-spacing: 0.13em;
    color: var(--agency-orange);
    margin-bottom: 20px;
  }
  .agency-hero {
    padding: clamp(28px, 5vw, 68px);
    background:
      linear-gradient(100deg, #131217ee, #17141bc4),
      url("../../assets/materials/background-haze.png") center/cover;
    border-top: 1px solid #b2663f;
    clip-path: polygon(
      20px 0,
      100% 0,
      100% calc(100% - 20px),
      calc(100% - 20px) 100%,
      0 100%,
      0 20px
    );
  }
  .agency-page h1 {
    font-size: clamp(29px, 4.4vw, 57px);
    line-height: 1.3;
    max-width: 23ch;
  }
  .agency-page h1 > span {
    color: var(--agency-orange);
  }
  .agency-page h1 em {
    display: block;
    font-size: 0.57em;
    font-style: normal;
    font-weight: 500;
    line-height: 1.6;
    margin-top: 15px;
    color: #bbb5bf;
    letter-spacing: -0.025em;
    max-width: 30ch;
  }
  .agency-page .agency-lead {
    max-width: 65ch;
    margin: 28px 0;
  }
  .agency-disciplines {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 25px;
    border-top: 1px solid #58443877;
    margin-top: 42px;
    padding-top: 22px;
    font:
      11px/1.6 Iosevka,
      monospace;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #b9aaa1;
  }
  .agency-section-heading {
    margin-bottom: 32px;
  }
  .agency-case-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    background: #18161ce0;
    border: 1px solid #70492f66;
    clip-path: polygon(
      14px 0,
      100% 0,
      100% calc(100% - 14px),
      calc(100% - 14px) 100%,
      0 100%,
      0 14px
    );
  }
  .agency-case-work,
  .agency-case-result {
    padding: clamp(24px, 3.7vw, 44px);
  }
  .agency-case-result {
    border-left: 1px solid #76503455;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: radial-gradient(ellipse at 75% 30%, #63351e30, transparent 80%);
  }
  .agency-period {
    color: #ddd7dd !important;
    font-size: 13px !important;
    margin-bottom: 28px !important;
  }
  .agency-period span {
    display: block;
    color: #99909b;
  }
  .agency-page .agency-case-work h3 {
    font:
      500 16px/1.5 Manrope,
      sans-serif;
    letter-spacing: 0;
    margin-bottom: 14px;
  }
  .agency-page ul {
    padding-left: 18px;
    margin: 0;
  }
  .agency-page li + li {
    margin-top: 10px;
  }
  .agency-page li::marker {
    color: #ce8052;
  }
  .agency-amount {
    display: flex;
    align-items: baseline;
    gap: 12px;
    white-space: nowrap;
    color: var(--agency-orange);
    line-height: 1;
    margin-bottom: 20px;
  }
  .agency-amount strong {
    font:
      600 clamp(64px, 6.9vw, 102px)/1 Oswald,
      sans-serif;
    letter-spacing: -0.04em;
  }
  .agency-currency {
    font:
      400 clamp(26px, 3vw, 42px)/1 Oswald,
      sans-serif;
  }
  .agency-plus {
    font-size: 0.57em;
    vertical-align: top;
    display: inline-block;
    margin-top: 0.13em;
    margin-left: 0.1em;
  }
  .agency-case-result p {
    font-size: 13px;
    max-width: 30ch;
  }
  .agency-case-result small {
    font-size: 11px;
    color: #776f7d;
    margin-top: 28px;
  }
  .agency-case-images {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    margin-top: 18px;
  }
  .agency-case-images > button {
    padding: 0;
    cursor: zoom-in;
    background: #121117;
    border: 1px solid #40332d;
    overflow: hidden;
    clip-path: polygon(
      12px 0,
      100% 0,
      100% calc(100% - 12px),
      calc(100% - 12px) 100%,
      0 100%,
      0 12px
    );
  }
  .agency-case-images > button:focus-visible {
    outline: 2px solid var(--agency-orange);
    outline-offset: 4px;
  }
  .agency-case-images img {
    display: block;
    width: 100%;
    height: 220px;
    object-fit: cover;
    object-position: top;
  }
  .agency-task-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }
  .agency-task {
    padding: 32px;
    background: linear-gradient(145deg, #231b1b88, #19171de0);
    border: 1px solid #5a443555;
    position: relative;
    clip-path: polygon(
      14px 0,
      100% 0,
      100% calc(100% - 14px),
      calc(100% - 14px) 100%,
      0 100%,
      0 14px
    );
  }
  .agency-task-index {
    font:
      12px Iosevka,
      monospace;
    color: #af704c;
    display: block;
    margin-bottom: 25px;
  }
  .agency-task h3 {
    font-size: clamp(17px, 1.7vw, 22px);
    line-height: 1.5;
    margin-bottom: 18px;
  }
  .agency-service-stack {
    display: grid;
    gap: 22px;
  }
  .agency-service {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    border: 1px solid #80533766;
    background: #19171de3;
    clip-path: polygon(
      18px 0,
      100% 0,
      100% calc(100% - 18px),
      calc(100% - 18px) 100%,
      0 100%,
      0 18px
    );
  }
  .agency-service-description {
    padding: clamp(24px, 3.4vw, 40px);
  }
  .agency-service-description h3 {
    font-size: clamp(20px, 2.3vw, 29px);
    line-height: 1.35;
    color: #f0e7e2;
    margin-bottom: 24px;
  }
  .agency-service-description p + p {
    margin-top: 14px;
  }
  .agency-service-scope {
    padding: clamp(24px, 3.4vw, 40px);
    background: linear-gradient(130deg, #582e181e, transparent);
    border-left: 1px solid #77523844;
  }
  .agency-service-scope h4 {
    font:
      11px/1.5 Iosevka,
      monospace;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: #c68c6c;
    margin-bottom: 22px;
  }
  .agency-page .agency-agreement {
    font-size: 13px;
    margin-top: 24px;
    color: #91868b;
  }
  .agency-faq {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(25px, 5vw, 65px);
  }
  .agency-faq details {
    border-top: 1px solid #59433988;
    padding: 24px 0;
  }
  .agency-faq details:last-child {
    border-bottom: 1px solid #59433988;
  }
  .agency-faq summary {
    display: flex;
    align-items: center;
    gap: 20px;
    justify-content: space-between;
    font:
      500 16px/1.6 Manrope,
      sans-serif;
    cursor: pointer;
    list-style: none;
  }
  .agency-faq summary::-webkit-details-marker {
    display: none;
  }
  .agency-faq summary:focus-visible {
    outline: 2px solid #ff783d;
    outline-offset: 5px;
  }
  .agency-faq details p {
    margin-top: 18px;
    font-size: 14px;
  }
  .agency-faq-toggle {
    position: relative;
    flex-shrink: 0;
    width: 18px;
    height: 18px;
  }
  .agency-faq-toggle:before,
  .agency-faq-toggle:after {
    content: "";
    position: absolute;
    background: #d68a5d;
    width: 12px;
    height: 1px;
    top: 8px;
    left: 3px;
  }
  .agency-faq-toggle:after {
    transform: rotate(90deg);
  }
  .agency-faq details[open] .agency-faq-toggle:after {
    transform: rotate(0deg);
  }
  .agency-contact {
    padding: clamp(28px, 5vw, 65px);
    border-top: 1px solid #b46a43;
    background:
      radial-gradient(ellipse at 100% 100%, #83402133, transparent 70%),
      #1b171ce8;
    clip-path: polygon(
      20px 0,
      100% 0,
      100% calc(100% - 20px),
      calc(100% - 20px) 100%,
      0 100%,
      0 20px
    );
  }
  .agency-contact p:not(.agency-eyebrow) {
    max-width: 62ch;
    margin: 24px 0 30px;
  }
  @media (max-width: 700px) {
    .agency-case-layout,
    .agency-task-grid,
    .agency-service,
    .agency-faq {
      grid-template-columns: 1fr;
    }
    .agency-case-result {
      border-left: 0;
      border-top: 1px solid #76503455;
    }
    .agency-hero {
      padding: 30px 24px;
    }
    .agency-page h1 {
      font-size: clamp(26px, 6.2vw, 40px);
    }
    .agency-task {
      padding: 26px;
    }
    .agency-service-scope {
      border-left: 0;
      border-top: 1px solid #77523844;
    }
    .agency-case-images {
      gap: 8px;
    }
    .agency-case-images img {
      height: 130px;
    }
    .agency-faq {
      gap: 0;
    }
    .agency-amount strong {
      font-size: 82px;
    }
    .agency-disciplines {
      gap: 10px 17px;
    }
    .agency-contact {
      padding: 30px 24px;
    }
  }
  @media (max-width: 370px) {
    .agency-hero,
    .agency-contact {
      padding-inline: 20px;
    }
    .agency-page h1 {
      font-size: 25px;
    }
    .agency-case-work,
    .agency-case-result,
    .agency-service-description,
    .agency-service-scope {
      padding: 22px;
    }
    .agency-case-images {
      grid-template-columns: 1fr;
    }
    .agency-case-images img {
      height: 180px;
    }
    .agency-amount strong {
      font-size: 72px;
    }
    .agency-task {
      padding: 22px;
    }
  }
</style>
