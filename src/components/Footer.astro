---
import { site, footer } from '../data/site.ru';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<footer class="ftr">
  <div class="wrap ftr__in">
    <span>{footer.line}</span>
    <nav class="ftr__legal" aria-label="Правовая информация">
      <a href={`${base}/impressum/`}>{footer.impressum}</a>
      <a href={`${base}/datenschutz/`}>{footer.privacy}</a>
    </nav>
    <span class="ftr__links">
      {site.links.telegram && <a href={site.links.telegram} rel="me noopener" target="_blank">Telegram</a>}
      {site.links.youtube && <a href={site.links.youtube} rel="me noopener" target="_blank">YouTube</a>}
      {site.links.instagram && <a href={site.links.instagram} rel="me noopener" target="_blank">Instagram</a>}
      {site.links.github && <a href={site.links.github} rel="me noopener" target="_blank">GitHub</a>}
    </span>
  </div>
</footer>
<style>
  .ftr { border-top: 1px solid var(--border-faint); padding: 28px 0 40px; font-size: 13px; color: var(--ink-3); }
  .ftr__in { display: flex; flex-wrap: wrap; gap: 14px 28px; justify-content: space-between; align-items: center; }
  .ftr__legal { display: flex; flex-wrap: wrap; gap: 8px 20px; }
  .ftr__legal a { color: var(--ink-2); }
  .ftr__legal a:hover { color: var(--ink-max); }
  .ftr__links { display: flex; flex-wrap: wrap; gap: 18px; font-weight: 400; letter-spacing: .1em; text-transform: uppercase; }
</style>
